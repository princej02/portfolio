---
import { ClientRouter } from 'astro:transitions'
import { Font } from 'astro:assets'
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Cursor from '../components/Cursor.astro'
import Loader from '../components/Loader.astro'

interface Props {
	title?: string
	description?: string
	image?: string
	type?: 'website' | 'article'
}

const {
	title = 'Prince Jecco-Obi — Developer',
	description = 'I build interfaces that feel as good as they look, and systems that do exactly what they should.',
	image = '/og-image.png',
	type = 'website',
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const ogImageURL = new URL(image, Astro.site)

const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Prince Jecco-Obi',
	jobTitle: 'Developer',
	url: Astro.site?.toString(),
	sameAs: ['https://github.com/princej02'],
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="alternate" type="application/rss+xml" title="Prince Jecco-Obi" href="/rss.xml" />
		<link rel="canonical" href={canonicalURL} />
		<Font cssVariable="--font-mono" />
		<Font cssVariable="--font-sans" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />

		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="Prince Jecco-Obi" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

		<ClientRouter />
	</head>
	<body class="bg-background text-text font-sans">
		<Loader />
		<Cursor />
		<Header />
		<slot />
		<Footer />
	</body>
</html>

<script>
	import Lenis from "lenis";

	// This script re-runs on every Astro view-transition navigation (it isn't
	// inside a transition:persist element), so any previous instance must be
	// torn down first — otherwise multiple Lenis instances stack up and fight
	// over scroll, which is what made scrolling feel rough after navigating.
	;(window as any).lenis?.destroy()
	;(window as any).lenis = new Lenis({
		duration: 1.2,
		easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
		anchors: true,
		autoRaf: true,
	})
</script>
