---
---

<div id="loader" aria-hidden="true">
  <div class="loader-inner">
    <p class="loader-eyebrow">Initializing</p>
    <h1 class="loader-name" data-text="Prince Jecco-Obi"></h1>
    <p class="loader-count"><span id="loader-percent">0</span>%</p>
  </div>
</div>

<style>
  #loader {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    background: var(--color-background);
    opacity: 0;
    pointer-events: none;
  }

  #loader.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  #loader.is-leaving {
    transition: transform 0.55s cubic-bezier(0.76, 0, 0.24, 1);
    transform: translateY(-100%);
  }

  .loader-inner {
    width: 100%;
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .loader-eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }

  .loader-name {
    display: flex;
    flex-wrap: wrap;
    font-size: clamp(2.25rem, 7vw, 4.5rem);
    font-weight: 700;
    line-height: 1;
  }

  .loader-name .char {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.4em);
    animation: char-in 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--i) * 30ms);
  }

  .loader-name .char.is-space {
    width: 0.28em;
  }

  @keyframes char-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .loader-count {
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }
</style>

<script>
  const STAGGER_MS = 30
  const CHAR_DURATION_MS = 450
  const HOLD_MS = 200
  const WIPE_MS = 550

  const w = window as any
  const loader = document.getElementById('loader')
  const nameEl = loader?.querySelector<HTMLElement>('.loader-name')
  const percentEl = document.getElementById('loader-percent')

  // Only the very first page load of the session should run this — later
  // Astro view-transition navigations re-execute this script, and the
  // loader must stay invisible (its default state) rather than replay.
  if (loader && nameEl && !w.__loaderRan && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    w.__loaderRan = true

    const text = nameEl.dataset.text ?? ''
    nameEl.innerHTML = ''
    ;[...text].forEach((ch, i) => {
      const span = document.createElement('span')
      span.className = ch === ' ' ? 'char is-space' : 'char'
      span.style.setProperty('--i', String(i))
      span.textContent = ch === ' ' ? ' ' : ch
      nameEl.appendChild(span)
    })

    document.documentElement.style.overflow = 'hidden'
    loader.classList.add('is-active')

    const countDuration = (text.length - 1) * STAGGER_MS + CHAR_DURATION_MS + HOLD_MS
    let start: number | null = null

    function tick(ts: number) {
      if (start === null) start = ts
      const elapsed = ts - start
      const pct = Math.min(100, Math.round((elapsed / countDuration) * 100))
      if (percentEl) percentEl.textContent = String(pct)
      if (elapsed < countDuration) {
        requestAnimationFrame(tick)
      } else {
        finish()
      }
    }
    requestAnimationFrame(tick)

    function finish() {
      if (!loader) return
      loader.classList.add('is-leaving')
      document.documentElement.style.overflow = ''
      setTimeout(() => {
        loader.classList.remove('is-active', 'is-leaving')
      }, WIPE_MS)
    }
  }
</script>
